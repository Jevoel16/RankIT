# Optional. Only the Local block is active.
# VITE_API_URL: leave unset to use same-origin /api (Vite dev proxy locally, Vercel rewrite
#   in deployments). Set it only if the API lives on another origin.
# VITE_DEV_API_TARGET: where the Vite dev server proxies /api during `npm start` (unused in builds).

# ===== Local =====
# VITE_API_URL=/api
VITE_DEV_API_TARGET=http://localhost:5000

# ===== Development =====
# VITE_API_URL=/api
# VITE_DEV_API_TARGET=http://localhost:5000

# ===== Production =====
# VITE_API_URL=/api
# VITE_DEV_API_TARGET=http://localhost:5000
