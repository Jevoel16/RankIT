# Copy to backend/.env. Only the Local block is active; on Vercel set the
# Development (Preview) and Production values in the project's environment variables.
# JWT_SECRET: long random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# CORS_ORIGIN: comma-separated extra browser origins; leave empty to allow any origin (LAN devices, local only).
# APP_URL: public URL, no trailing slash. OAuth callbacks are <APP_URL>/api/auth/google/callback
#   and <APP_URL>/api/auth/github/callback. On Vercel it defaults to the production domain when unset.
# GOOGLE_* / GITHUB_*: each provider is enabled only when both values are set.
# SUPERADMIN_*: optional input for `npm run create:superadmin` (it prompts when unset).
# SEED_PASSWORD: shared password for `npm run seed:users`, local databases only (defaults to 1234).

# ===== Local =====
PORT=5000
HOST=0.0.0.0
MONGODB_URI=mongodb://localhost:27017/RankIT_DB
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# SUPERADMIN_USERNAME=
# SUPERADMIN_PASSWORD=
SEED_PASSWORD=

# ===== Development =====
# PORT=5000
# HOST=0.0.0.0
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/RankIT_DB_dev?retryWrites=true&w=majority
# JWT_SECRET=<long-random-value>
# JWT_EXPIRES_IN=12h
# CORS_ORIGIN=
# APP_URL=https://<preview-domain>.vercel.app
# GOOGLE_CLIENT_ID=<google-client-id>
# GOOGLE_CLIENT_SECRET=<google-client-secret>
# GITHUB_CLIENT_ID=<github-client-id>
# GITHUB_CLIENT_SECRET=<github-client-secret>
# SUPERADMIN_USERNAME=
# SUPERADMIN_PASSWORD=
# SEED_PASSWORD=

# ===== Production =====
# PORT=5000
# HOST=0.0.0.0
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/RankIT_DB?retryWrites=true&w=majority
# JWT_SECRET=<long-random-value>
# JWT_EXPIRES_IN=12h
# CORS_ORIGIN=
# APP_URL=https://<production-domain>
# GOOGLE_CLIENT_ID=<google-client-id>
# GOOGLE_CLIENT_SECRET=<google-client-secret>
# GITHUB_CLIENT_ID=<github-client-id>
# GITHUB_CLIENT_SECRET=<github-client-secret>
# SUPERADMIN_USERNAME=
# SUPERADMIN_PASSWORD=
# SEED_PASSWORD=
