PORT=5000
HOST=0.0.0.0

# Local development
MONGODB_URI=mongodb://localhost:27017/RankIT_DB
# Production (MongoDB Atlas): copy the SRV string from Atlas > Connect > Drivers
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/RankIT_DB?retryWrites=true&w=majority

# Use a long random value in production, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=12h

# Comma-separated list of allowed browser origins. Required in production.
# Leave empty in development to allow any origin (LAN devices).
CORS_ORIGIN=http://localhost:3000

# Shared password for `npm run seed:users` (local databases only). Defaults to 1234.
SEED_PASSWORD=
